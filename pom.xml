                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <!-- Here come other details
                ...
                -->
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>es.upm.etsisi.poo.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <!-- Here come other details
                ...
